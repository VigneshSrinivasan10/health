{
  "name": "Daily Check-in",
  "short_name": "Check-in",
  "description": "A simple end-of-day mood check-in. How are you feeling? Pick your moods, rate them, jot a note. Local-only.",
  "start_url": "./",
  "scope": "./",
  "display": "standalone",
  "orientation": "portrait",
